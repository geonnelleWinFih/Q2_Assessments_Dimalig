      "source": [
        "from datetime import date\n",
        "\n",
        "# Ask for event details and dates\n",
        "title = input(\"Enter event title: \").strip()\n",
        "year = int(input(\"Enter year: \"))\n",
        "month = int(input(\"Enter month: \"))\n",
        "day = int(input(\"Enter day: \"))\n",
        "\n",
        "# Create a date object\n",
        "event_date = date(year, month, day)\n",
        "\n",
        "# Display formatted output under here\n",
        "print(\"Formatted Output:\")\n",
        "print(f\"Event: {title.upper()}\")\n",
        "print(f\"Date: {event_date.strftime('%B')} {event_date.day}, {event_date.year}\")\n",
        "print(f\"Year: {event_date.year}\")\n",
        "print(f\"Month: {event_date.strftime('%B')}\")\n",
        "print(f\"Day: {event_date.day}\")\n",
        "print(f\"Weekday: {event_date.strftime('%A')}\")\n",
        "\n",
        "#For Output, please type in proper and relevant information, thanks :D"
