#The user will have to type in two of their desired numbers and select the operation that will be used
num1 = int(input("Type in first number: "))
num2 = int(input("Type in second number: "))
operation = input("Please select an operation: ")

#This part defines what functions does each operation do
def add_numbers(a, b):
  return a + b

def subtract_numbers(a, b):
  return a - b

def multiply_numbers(a, b):
  return a * b

def divide_numbers(a, b):
  return a / b

#This is where it calculates and print the output
if operation == "Addition":
  print(add_numbers(num1, num2))

elif operation == "Subtraction":
  print(subtract_numbers(num1, num2))

elif operation == "Multiplication":
  print(multiply_numbers(num1, num2))

elif operation == "Division":
  print(divide_numbers(num1, num2))

